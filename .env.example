# Meta Model API key (Standard mode). Never commit the real .env.
MODEL_API_KEY=
# 32 random bytes, base64 — AES-256-GCM key for originals at rest. `make setup` generates one.
TURNPROOF_DATA_KEY=
# Path to the Ed25519 private key PEM. `make setup` generates keys/turnproof-demo-2026.pem
TURNPROOF_SIGNING_KEY=keys/turnproof-demo-2026.pem
